<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    app:startDestination="@id/homeFragment">

    <!-- Home screen -->
    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.myapplication2.HomeFragment"
        android:label="Home">

        <!-- Home -> Details -->
        <action
            android:id="@+id/action_home_to_details"
            app:destination="@id/detailsFragment" />
    </fragment>

    <!-- Details screen -->
    <fragment
        android:id="@+id/detailsFragment"
        android:name="com.example.myapplication2.DetailsFragment"
        android:label="Details">

        <!-- Details -> Settings -->
        <action
            android:id="@+id/action_details_to_settings"
            app:destination="@id/settingsFragment" />
    </fragment>

    <!-- Settings screen -->
    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.example.myapplication2.SettingsFragment"
        android:label="Settings" />
</navigation>